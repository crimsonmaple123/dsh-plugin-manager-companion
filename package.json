{
  "name": "dsh-plugin-manager-companion-cmaple",
  "version": "0.2.0",
  "description": "Companion to the official DSH plugin manager: pre-install quality gate, deep environment diagnostics, plugin marketplace, and skills/presets management.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "plugin-manager",
    "companion",
    "marketplace",
    "diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crimsonmaple123/dsh-plugin-manager-companion.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.en.md",
    "docs/images/readme",
    "docs/MIGRATION-0.2.1.md",
    "docs/INSTALL-LOCAL.md"
  ],
  "bin": {
    "dshpmc": "./dist/cli.js"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:host": "node tools/build.mjs --host",
    "build:client": "node tools/build.mjs --client",
    "typecheck": "tsc --noEmit",
    "test": "node tools/build.mjs && node tools/run-tests.mjs"
  },
  "engines": {
    "dsh": "^0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-rc.3",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "js-yaml": "^4.3.1"
  },
  "dependencies": {
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-group": "~1.0.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-hmr": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.3",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "js-yaml": "^4.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
